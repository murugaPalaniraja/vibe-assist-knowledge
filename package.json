{
  "name": "vibe-assist-knowledge",
  "version": "0.1.0",
  "private": true,
  "description": "Static, indexable software-engineering knowledge site for Vibe-Assist (Understand / Learn / Review / Apply / Prompt).",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate && astro build",
    "preview": "astro preview",
    "validate": "node scripts/validate-content.mjs",
    "check-links": "node scripts/check-links.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "ci": "npm run build && npm run check-links && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  }
}
