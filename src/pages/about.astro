---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArticles, href, slugOf } from '../lib/site';

const articles = await getArticles();
// Every external source cited anywhere on the site, de-duplicated by URL.
const sources = new Map<string, { title: string; license?: string; usedBy: { slug: string; title: string }[] }>();
for (const a of articles) {
  const list = [
    ...a.data.sources.map((s) => ({ title: s.title, url: s.url, license: s.license })),
    ...(a.data.provenance ? [{ title: a.data.provenance.name, url: a.data.provenance.url, license: a.data.provenance.license }] : []),
  ];
  for (const s of list) {
    const entry = sources.get(s.url) ?? { title: s.title, license: s.license, usedBy: [] };
    entry.usedBy.push({ slug: slugOf(a), title: a.data.title });
    sources.set(s.url, entry);
  }
}
const sorted = [...sources.entries()].sort((a, b) => a[1].title.localeCompare(b[1].title));
const ingested = articles.filter((a) => a.data.origin === 'ingested');
---
<BaseLayout
  title="About Vibe Knowledge and Its Sources"
  description="What Vibe Knowledge is, how its content is written and ingested, how sources and licenses are tracked, and a full list of references cited on the site."
  path="/about"
  breadcrumbs={[{ name: 'About & Sources', path: '/about' }]}
>
  <article class="prose">
    <h1>About Vibe Knowledge and Its Sources</h1>
    <p class="lede">Vibe Knowledge is the grounding knowledge base for Vibe-Assist, an assistant that helps developers understand and review what AI coding agents build.</p>

    <h2>What This Site Is (and Is Not)</h2>
    <ul>
      <li><strong>It is</strong> a retrieval and grounding source. Pages are written so that a search engine and an LLM agent can find one focused page per concept and quote it accurately.</li>
      <li><strong>It is not</strong> a training dataset. Vibe-Assist does not train or fine-tune a model. The LLM reads these pages at question time.</li>
      <li><strong>It is not</strong> a generic encyclopedia. Every article is organised around Understand, Learn, Review, Apply and Prompt for code produced by coding agents.</li>
    </ul>

    <h2>How Content Is Produced</h2>
    <p><strong>Curated articles</strong> are written and reviewed by people and cite their references. <strong>Reference notes</strong> ({ingested.length} currently) are generated by the separate <em>vibe-assist-ingestion</em> pipeline from approved sources. They keep full provenance (source name, URL, license, retrieval date), are labelled on the page, and thin excerpts are marked <code>noindex</code>.</p>

    <h2>Why the URLs Are Short</h2>
    <p>Every page lives at a single path segment, such as <a href={href('/spring-security-jwt')}>/spring-security-jwt</a>. Navigation provides the hierarchy (category → technology → article). Shallow URLs keep each page independently indexable, and they fit the URL-depth limits of public-website knowledge sources in Copilot agents.</p>

    <h2>Machine-Readable Endpoints</h2>
    <ul>
      <li><a href={href('/sitemap.xml')}>/sitemap.xml</a> lists every indexable page</li>
      <li><a href={href('/rss.xml')}>/rss.xml</a> lists recently updated articles and prompts</li>
      <li><a href={href('/llms.txt')}>/llms.txt</a> gives a plain-text site map for LLM tools</li>
      <li><a href={href('/search-index.json')}>/search-index.json</a> is a lightweight search index (titles, summaries and tags only)</li>
    </ul>

    <h2 id="sources">Sources Cited on This Site</h2>
    <p>{sorted.length} distinct references. Licenses are shown where known. Where no license is listed, we link to the source rather than reproduce it.</p>
    <ul>
      {sorted.map(([url, s]) => (
        <li>
          {/^https?:\/\//.test(url) ? <a href={url} rel="noopener">{s.title}</a> : <span>{s.title} <code>{url}</code></span>}{s.license && <span class="muted"> ({s.license})</span>}
          <span class="small muted"> — cited by {s.usedBy.map((u, i) => <>{i > 0 && ', '}<a href={href('/' + u.slug)}>{u.title}</a></>)}</span>
        </li>
      ))}
    </ul>
  </article>
</BaseLayout>
