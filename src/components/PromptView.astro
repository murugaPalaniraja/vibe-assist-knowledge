---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  type Article, type PromptPattern,
  href, absoluteUrl, slugOf, truncate, promptCategoryOf, resolveRelated, techSlug, SITE_NAME,
} from '../lib/site';

interface Props { prompt: PromptPattern; articles: Article[]; prompts: PromptPattern[] }
const { prompt, articles, prompts } = Astro.props;
const d = prompt.data;
const slug = slugOf(prompt);
const path = '/' + slug;
const cat = promptCategoryOf(d.category);
const { Content } = await render(prompt);
const related = resolveRelated(d.related, articles, prompts);
// Articles that point at this prompt pattern.
const usedBy = articles
  .filter((a) => a.data.prompts.includes(slug) && !d.related.includes(slugOf(a)))
  .map((a) => ({ slug: slugOf(a), title: a.data.title }));
const description = d.description ?? truncate(d.purpose, 160);

const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: d.title,
  description,
  url: absoluteUrl(path, Astro.site),
  dateModified: d.updated.toISOString().slice(0, 10),
  genre: 'Prompt pattern',
  keywords: d.tags.join(', '),
  isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: absoluteUrl('/', Astro.site) },
}];
---
<BaseLayout
  title={d.title}
  description={description}
  path={path}
  ogType="article"
  modified={d.updated}
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: 'Prompt Library', path: '/prompts' },
    { name: d.title, path },
  ]}
>
  <article class="prose">
    <header>
      <h1>{d.title}</h1>
      <p class="lede">{d.purpose}</p>
      <ul class="meta-row" aria-label="Prompt metadata">
        <li><a class="pill accent" href={href('/prompts#' + cat.slug)}>{cat.name}</a></li>
        {d.technology.map((t) => {
          const ts = techSlug(t);
          return <li>{ts ? <a class="pill" href={href('/' + ts)}>{t}</a> : <span class="pill">{t}</span>}</li>;
        })}
      </ul>
    </header>

    <section aria-labelledby="inputs">
      <h2 id="inputs">Inputs to Provide</h2>
      <ul>{d.inputs.map((i) => <li><code>{i}</code></li>)}</ul>
    </section>

    {d.checks.length > 0 && (
      <section aria-labelledby="checks">
        <h2 id="checks">What the Prompt Makes the Agent Check</h2>
        <ul class="checklist">{d.checks.map((c) => <li>{c}</li>)}</ul>
      </section>
    )}

    <section aria-labelledby="template">
      <h2 id="template">Prompt Template</h2>
      <p>Replace the <code>{'{{placeholders}}'}</code> with your own context. The template is plain text so it can be pasted into any coding agent.</p>
      <div class="prompt-template">
        <button class="copy-btn" type="button" data-copy="tpl" hidden>Copy</button>
        <pre id="tpl"><code>{d.template.trim()}</code></pre>
      </div>
    </section>

    {d.output_format.length > 0 && (
      <section aria-labelledby="expected-output">
        <h2 id="expected-output">Expected Output Structure</h2>
        <ol>{d.output_format.map((o) => <li>{o}</li>)}</ol>
      </section>
    )}

    <Content />

    {(related.length > 0 || usedBy.length > 0) && (
      <section aria-labelledby="related-knowledge">
        <h2 id="related-knowledge">Related Knowledge</h2>
        <ul>
          {related.map((r) => <li><a href={href('/' + r.slug)}>{r.title}</a> — {r.summary}</li>)}
          {usedBy.map((r) => <li><a href={href('/' + r.slug)}>{r.title}</a></li>)}
        </ul>
      </section>
    )}
  </article>
  <script is:inline>
    // Progressive enhancement only: the template is fully present in the HTML.
    document.querySelectorAll('[data-copy]').forEach(function (btn) {
      if (!navigator.clipboard) return;
      btn.hidden = false;
      btn.addEventListener('click', function () {
        var el = document.getElementById(btn.getAttribute('data-copy'));
        navigator.clipboard.writeText(el.innerText).then(function () {
          btn.textContent = 'Copied';
          setTimeout(function () { btn.textContent = 'Copy'; }, 1500);
        });
      });
    });
  </script>
</BaseLayout>
