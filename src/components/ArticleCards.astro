---
import { type Article, href, slugOf, describe } from '../lib/site';
interface Props { articles: Article[]; headingLevel?: 'h2' | 'h3' }
const { articles, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<ul class="card-grid">
  {articles.map((a) => (
    <li class="card">
      <H><a href={href('/' + slugOf(a))}>{a.data.title}</a></H>
      <p>{describe(a)}</p>
    </li>
  ))}
</ul>
